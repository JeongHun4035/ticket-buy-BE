# PowerShell 등 실행 환경에 직접 설정하세요. Spring은 .env를 자동 로딩하지 않습니다.
SPRING_PROFILES_ACTIVE=dev
PUBLIC_BASE_URL=http://localhost:8080
# dev 기본 H2. PostgreSQL 개발 실행 시 아래 값을 설정합니다.
DB_URL=jdbc:postgresql://localhost:5432/ticketbuy
DB_USER=ticketbuy
DB_PASSWORD=change-this-local-password
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false
QUEUE_CAPACITY=50
ADMISSION_SECONDS=600
HOLD_SECONDS=300
QUEUE_ADMIT_BATCH_SIZE=20
QUEUE_POLL_SECONDS=3
SEAT_READ_MIN_SECONDS=2
QUEUE_WORKER_INTERVAL_MS=1000
# prod: SPRING_PROFILES_ACTIVE=prod, COOKIE_SECURE 강제 true
# CORS_ORIGINS=https://tickets.example.com
# API_DOCS_ENABLED=false
